    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.1",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.13.9",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "prisma": "6.19.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
