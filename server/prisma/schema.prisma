datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  ESTIMATOR
  SALES_HEAD
}

enum RfqStatus {
  ESTIMATING
  SENT
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SENT
}

enum QuoteApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedRfqs         Rfq[]           @relation("RfqOwner")
  uploadedDocuments RfqDocument[]
  createdQuotations Quotation[]     @relation("QuotationCreator")
  approvals         QuoteApproval[]
  generatedPdfs     QuotationPdf[]  @relation("QuotationPdfGenerator")
  intakeDrafts      IntakeDraft[]   @relation("IntakeCreator")
  uploadedIntakeDocs IntakeDocument[]
  importedHistoricalBatches HistoricalImportBatch[] @relation("HistoricalBatchImporter")
  createdHistoricalRecords  HistoricalQuoteRecord[] @relation("HistoricalRecordCreator")
  auditLogs         AuditLog[]

  @@map("users")
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  industry     String
  contactEmail String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rfqs Rfq[]

  @@map("customers")
}

model Rfq {
  id          String    @id @default(uuid())
  rfqNumber   String    @unique
  customerId  String
  title       String
  description String?
  receivedAt  DateTime  @default(now())
  dueDate     DateTime?
  status      RfqStatus @default(ESTIMATING)
  ownerId     String?
  lostReason  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  owner      User?         @relation("RfqOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  parts      RfqPart[]
  documents  RfqDocument[]
  quotations Quotation[]

  @@index([customerId])
  @@index([ownerId])
  @@index([status])
  @@map("rfqs")
}

model RfqPart {
  id            String   @id @default(uuid())
  rfqId         String
  partNumber    String?
  partName      String
  drawingNumber String?
  material      String
  grossWeightKg Decimal  @db.Decimal(10, 4)
  annualVolume  Int
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rfq               Rfq                @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  routingOperations RoutingOperation[]
  quoteParts        QuotePart[]

  @@index([rfqId])
  @@map("rfq_parts")
}

model RfqDocument {
  id           String   @id @default(uuid())
  rfqId        String
  fileName     String
  storagePath  String
  mimeType     String
  sizeBytes    BigInt
  uploadedById String?
  createdAt    DateTime @default(now())

  rfq        Rfq   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([rfqId])
  @@index([uploadedById])
  @@map("rfq_documents")
}

model MaterialRate {
  id           String    @id @default(uuid())
  materialCode String
  materialName String
  ratePerKg    Decimal   @db.Decimal(12, 4)
  currency     String    @default("INR")
  validFrom    DateTime
  validTo      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([materialCode])
  @@index([validFrom, validTo])
  @@map("material_rates")
}

model MachineRate {
  id            String    @id @default(uuid())
  operationCode String
  operationName String
  machineName   String
  hourlyRate    Decimal   @db.Decimal(12, 4)
  currency      String    @default("INR")
  validFrom     DateTime
  validTo       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([operationCode])
  @@index([validFrom, validTo])
  @@map("machine_rates")
}

model RoutingOperation {
  id               String   @id @default(uuid())
  partId           String
  sequence         Int
  operationName    String
  machineCode      String
  setupTimeMinutes Decimal  @default(0) @db.Decimal(8, 2)
  cycleTimeMinutes Decimal  @db.Decimal(8, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  part RfqPart @relation(fields: [partId], references: [id], onDelete: Cascade)

  @@index([partId])
  @@map("routing_operations")
}

model Quotation {
  id                 String          @id @default(uuid())
  quoteNumber        String          @unique
  rfqId              String
  version            Int             @default(1)
  status             QuotationStatus @default(DRAFT)
  createdById        String
  submittedAt        DateTime?
  approvedAt         DateTime?
  isHistoricalImport Boolean         @default(false)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  rfq        Rfq             @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  createdBy  User            @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  quoteParts QuotePart[]
  approvals  QuoteApproval[]
  pdf        QuotationPdf?

  @@unique([rfqId, version])
  @@index([rfqId])
  @@index([status])
  @@index([createdById])
  @@map("quotations")
}

model QuotePart {
  id            String   @id @default(uuid())
  quotationId   String
  rfqPartId     String
  rateSnapshot  Json
  costBreakdown Json
  createdAt     DateTime @default(now())

  quotation    Quotation          @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqPart      RfqPart            @relation(fields: [rfqPartId], references: [id], onDelete: Restrict)
  volumePrices QuoteVolumePrice[]

  @@index([quotationId])
  @@index([rfqPartId])
  @@map("quote_parts")
}

model QuoteVolumePrice {
  id                  String   @id @default(uuid())
  quotePartId         String
  productionVolume    Int
  materialCost        Decimal  @db.Decimal(14, 4)
  processCost         Decimal  @db.Decimal(14, 4)
  scrapCost           Decimal  @db.Decimal(14, 4)
  overheadCost        Decimal  @db.Decimal(14, 4)
  freightCost         Decimal  @db.Decimal(14, 4)
  totalCost           Decimal  @db.Decimal(14, 4)
  marginPercentage    Decimal  @db.Decimal(6, 2)
  sellingPricePerUnit Decimal  @db.Decimal(14, 4)
  annualValue         Decimal  @db.Decimal(16, 4)
  gstPercentage       Decimal  @default(18) @db.Decimal(5, 2)
  createdAt           DateTime @default(now())

  quotePart QuotePart @relation(fields: [quotePartId], references: [id], onDelete: Cascade)

  @@index([quotePartId])
  @@map("quote_volume_prices")
}

model QuoteApproval {
  id          String              @id @default(uuid())
  quotationId String
  reviewerId  String
  status      QuoteApprovalStatus @default(PENDING)
  comments    String?
  reviewedAt  DateTime?
  createdAt   DateTime            @default(now())

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  reviewer  User      @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([reviewerId])
  @@map("quote_approvals")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  entityType String
  entityId   String
  action     String
  details    Json?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model QuotationPdf {
  id             String   @id @default(uuid())
  quotationId    String   @unique
  storagePath    String
  fileName       String
  mimeType       String   @default("application/pdf")
  sizeBytes      BigInt
  checksumSha256 String?
  generatedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  generatedBy User?     @relation("QuotationPdfGenerator", fields: [generatedById], references: [id], onDelete: SetNull)

  @@index([quotationId])
  @@index([generatedById])
  @@map("quotation_pdfs")
}

model IntakeDraft {
  id            String   @id @default(uuid())
  createdById   String
  emailText     String?  @db.Text
  status        String   @default("DRAFT")
  extractedData Json?
  rfqId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy User             @relation("IntakeCreator", fields: [createdById], references: [id], onDelete: Cascade)
  documents IntakeDocument[]

  @@index([createdById])
  @@index([status])
  @@map("intake_drafts")
}

model IntakeDocument {
  id            String   @id @default(uuid())
  intakeDraftId String?
  fileName      String
  storagePath   String
  mimeType      String
  sizeBytes     BigInt
  extractedText String?  @db.Text
  uploadedById  String
  createdAt     DateTime @default(now())

  intakeDraft IntakeDraft? @relation(fields: [intakeDraftId], references: [id], onDelete: Cascade)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([intakeDraftId])
  @@index([uploadedById])
  @@map("intake_documents")
}

model HistoricalImportBatch {
  id             String   @id @default(uuid())
  fileName       String
  totalRows      Int
  importedRows   Int
  invalidRows    Int
  duplicateRows  Int
  status         String   @default("COMPLETED")
  errorSummary   Json?
  importedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  importedBy User                   @relation("HistoricalBatchImporter", fields: [importedById], references: [id], onDelete: Cascade)
  records    HistoricalQuoteRecord[]

  @@index([importedById])
  @@index([createdAt])
  @@map("historical_import_batches")
}

model HistoricalQuoteRecord {
  id                 String    @id @default(uuid())
  quoteReference     String
  customerName       String
  partNumber         String?
  partDescription    String?   @db.Text
  material           String?
  grossWeightKg      Decimal?  @db.Decimal(12, 4)
  quantity           Int?
  unitPrice          Decimal?  @db.Decimal(14, 4)
  currency           String    @default("INR")
  quoteDate          DateTime?
  processDescription String?   @db.Text
  sourceFileName     String
  sourceSheet        String?
  sourceRow          Int
  batchId            String
  importStatus       String    @default("IMPORTED")
  createdById        String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  batch     HistoricalImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("HistoricalRecordCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([quoteReference])
  @@index([customerName])
  @@index([partNumber])
  @@index([material])
  @@index([quoteDate])
  @@index([batchId])
  @@index([createdById])
  @@map("historical_quote_records")
}
